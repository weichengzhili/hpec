{
  "schema_version": "1.0.0",
  "module": "system/document-resource-management",
  "purpose": "将软硬件交互入口与硬件系统工程问题作为系统文档资源进行分级治理。",
  "priority_model": [
    {
      "id": "P0",
      "name": "架构基石",
      "rule": "不解决会导致系统不可启动、不可控、数据损坏、安全失效或不可恢复故障。",
      "change_control": "architecture-review-required"
    },
    {
      "id": "P1",
      "name": "系统闭环",
      "rule": "不解决会导致系统可运行但不可验证、不可诊断、不可实时保证或不可维护。",
      "change_control": "impact-analysis-required"
    },
    {
      "id": "P2",
      "name": "工程效率",
      "rule": "不解决不会立即造成系统错误，但会显著降低开发、评审和量产维护效率。",
      "change_control": "owner-review"
    },
    {
      "id": "P3",
      "name": "优化增强",
      "rule": "用于性能、成本、功耗、体验层面的进一步优化。",
      "change_control": "owner-maintained"
    }
  ],
  "lifecycle": [
    "draft",
    "review",
    "approved",
    "baseline",
    "frozen",
    "deprecated",
    "archived"
  ],
  "required_fields": [
    "id",
    "title",
    "priority",
    "category",
    "status",
    "owner",
    "source_of_truth",
    "path",
    "questions",
    "outputs",
    "consumers",
    "validation",
    "security_level"
  ],
  "resources": [
    {
      "id": "DOC-SYS-000",
      "title": "文档资源治理规则",
      "priority": "P0",
      "category": "契约",
      "status": "baseline",
      "owner": "architecture-board",
      "source_of_truth": "system/document-resource-management/manifest/document_resource_manifest.json",
      "path": "system/document-resource-management/文档资源管理.md",
      "questions": [
        "文档如何编号、分级、评审、变更和归档？",
        "谁是每条文档资源的 owner？",
        "什么内容必须指定单一数据源？"
      ],
      "outputs": [
        "资源元模型",
        "生命周期状态机",
        "优先级变更规则"
      ],
      "consumers": [
        "system/*"
      ],
      "validation": [
        "schema-validation",
        "id-uniqueness-check",
        "status-machine-check"
      ],
      "security_level": "internal"
    },
